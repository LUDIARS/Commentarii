{
  "name": "commentarii",
  "version": "0.2.0",
  "private": true,
  "description": "Strategy guide maker (schema, validate, render, knowledge report, learning, intent verification); the auto player moved to Ingenium",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/sdk"
  ],
  "bin": {
    "guide": "dist/cli/main.js"
  },
  "imports": {
    "#contract-runtime": {
      "types": "./packages/sdk/contract-runtime.d.mts",
      "default": "./packages/sdk/contract-runtime.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p packages/sdk/tsconfig.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p packages/sdk/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "dev": "node dist/health/main.js",
    "guide": "node dist/cli/main.js"
  },
  "dependencies": {
    "@ludiars/commentarii-sdk": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~5.9.3"
  }
}
