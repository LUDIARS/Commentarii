{
  "service": "commentarii",
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "src/contracts/**"],
  "runtime": {
    "autoImport": false,
    "entrypoints": ["src/cli/main.ts"]
  },
  "rules": {
    "entry-runtime": false,
    "silent-catch": false,
    "spawn-watch": false,
    "interval-guard": false,
    "listener-guard": false,
    "contract-wrap": true
  },
  "importFrom": "#contract-runtime"
}
