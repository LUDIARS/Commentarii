{
  "id": "tactic:bestia:enemy-attack",
  "name": {
    "ja": "射程内なら撃つ",
    "en": "Attack within reach"
  },
  "when": {
    "all": [
      {
        "not": {
          "self": {
            "hp_ratio_lt": 0.25
          }
        }
      },
      {
        "entity": "actor:bestia:player",
        "visible": true,
        "within_reach": true,
        "as": "$player"
      },
      {
        "not": {
          "event": "shot-at"
        }
      },
      {
        "not": {
          "self": {
            "at_node": "node:outside"
          }
        }
      }
    ]
  },
  "do": [
    {
      "attack": "$player"
    }
  ],
  "expect": {
    "reflex": true
  },
  "because": [
    "state:bestia:battle-ai"
  ],
  "knowledge": "discoverable",
  "confidence": "authored",
  "superseded_by": null
}
