{
  "id": "action:bestia:retreat",
  "name": { "ja": "後退", "en": "Retreat" },
  "actor": ["entity"],
  "params": {
    "threat": { "kind": "entity" },
    "for": { "kind": "number", "unit": "s", "range": [0.1, 2], "step": 0.1, "default": 0.1 }
  },
  "maps_to": { "custom": "retreat", "target": "$threat" },
  "pre": "1",
  "duration": "$for",
  "motion": { "kind": "away", "goal": "$threat", "speed": "speed(actor)" },
  "effects": [{ "at": "start", "outcomes": [{ "p": 1, "assign": [{ "var": "moved", "of": "actor", "expr": "1" }] }] }],
  "knowledge": "discoverable",
  "source": { "kind": "master", "ref": "Bestia src/behavior.cpp Task::Wounded (back away)" }
}
