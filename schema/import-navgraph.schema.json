{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "import-navgraph.schema.json",
  "title": "Input of guide import map --kind navgraph",
  "description": "Nodes with positions and edges between them. Node IDs may omit the node: prefix. Every knowledge left out defaults to masked.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "coordinates": { "$ref": "#/$defs/coordinates" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pos"],
        "properties": {
          "id": { "$ref": "#/$defs/nodeName" },
          "pos": { "$ref": "#/$defs/point" },
          "label": { "$ref": "id.schema.json#/$defs/localizedText" },
          "knowledge": { "$ref": "value.schema.json#/$defs/knowledge" }
        },
        "additionalProperties": false
      }
    },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
  },
  "additionalProperties": false,
  "$defs": {
    "nodeName": { "type": "string", "pattern": "^(node:)?[a-z0-9][a-z0-9_-]*$" },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
    "coordinates": {
      "description": "Coordinate system the input was written in; must equal the manifest when given.",
      "type": "object",
      "required": ["system", "unit"],
      "properties": {
        "system": { "enum": ["grid", "world-xy", "world-xyz"] },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeName" },
        "to": { "$ref": "#/$defs/nodeName" },
        "directed": { "type": "boolean" },
        "cost": { "type": "number", "minimum": 0 },
        "knowledge": { "$ref": "value.schema.json#/$defs/knowledge" }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["target", "kind"],
      "properties": {
        "target": { "$ref": "#/$defs/nodeName" },
        "kind": { "enum": ["hazard", "resource", "shortcut", "spawn", "wanted", "unwanted"] },
        "ref": { "$ref": "id.schema.json#/$defs/anyId" },
        "note": { "$ref": "id.schema.json#/$defs/localizedText" },
        "knowledge": { "$ref": "value.schema.json#/$defs/knowledge" }
      },
      "additionalProperties": false
    }
  }
}
