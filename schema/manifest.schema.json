{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Guide bundle manifest",
  "type": "object",
  "required": ["game_id", "title", "version", "coordinates"],
  "properties": {
    "game_id": { "$ref": "id.schema.json#/$defs/slug" },
    "title": { "$ref": "id.schema.json#/$defs/localizedText" },
    "version": { "type": "string", "minLength": 1 },
    "builds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "coordinates": {
      "type": "object",
      "required": ["system", "unit"],
      "properties": {
        "system": { "enum": ["grid", "world-xy", "world-xyz"] },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lexicon": {
      "type": "object",
      "required": ["version"],
      "properties": { "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "required": ["policy"],
      "properties": { "policy": { "$ref": "#/$defs/policy" } },
      "additionalProperties": false
    },
    "audit": { "$ref": "#/$defs/audit" },
    "observation": {
      "description": "Observation boundary (spec/feature/observation-boundary.md): the game-specific observation fields a player frame may carry, each with its knowledge and where it comes from. Undeclared fields are refused in player mode.",
      "type": "object",
      "required": ["fields"],
      "properties": { "fields": { "$ref": "observation-fields.schema.json#/$defs/fields" } },
      "additionalProperties": false
    },
    "feasibility": {
      "description": "Feasibility band thresholds (design 8.5, spec/feature/intent-verify.md 6.3). Every field is optional; absent ones take the defaults.",
      "type": "object",
      "properties": {
        "thresholds": {
          "type": "object",
          "properties": {
            "feasible_success": { "$ref": "#/$defs/ratio" },
            "min_runs": { "type": "integer", "minimum": 1 },
            "illusory_weight": { "type": "number", "minimum": 1 },
            "stall_after_sec": { "type": "number", "minimum": 0 },
            "stall_weight": { "type": "number", "minimum": 0 },
            "zero_success_upper": { "description": "Upper bound (95%) of the success rate below which a never-successful visible solution is illusory (default 0.2).", "$ref": "#/$defs/ratio" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "audit": {
      "description": "guide audit mask settings (spec/feature/mask-audit.md). Every allow entry must say why and who decided.",
      "type": "object",
      "properties": {
        "scan": {
          "type": "object",
          "properties": {
            "extensions": {
              "description": "Replaces the default list of scanned file extensions.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^\\.[a-z0-9]+(\\.[a-z0-9]+)*$" }
            }
          },
          "additionalProperties": false
        },
        "min_numeric_length": {
          "description": "Numbers with fewer significant digits are not compared (default 3).",
          "type": "integer",
          "minimum": 1
        },
        "forbidden_keys": {
          "description": "Key / field / property names that must not appear in the game's exposed surface.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "allow": {
          "type": "array",
          "items": { "$ref": "#/$defs/auditAllow" }
        }
      },
      "additionalProperties": false
    },
    "auditAllow": {
      "type": "object",
      "required": ["pattern", "rationale", "decided_by"],
      "properties": {
        "pattern": { "description": "Glob over the reported file path (** / * / ?).", "type": "string", "pattern": "\\S" },
        "kind": { "enum": ["value-hit", "key-hit", "undefined-exposure"] },
        "ref": { "description": "Only findings with this ref (masked value ref, forbidden key or literal).", "type": "string", "pattern": "\\S" },
        "rationale": { "type": "string", "pattern": "\\S" },
        "decided_by": { "type": "string", "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy": {
      "type": "object",
      "required": ["exploration_rate", "rewrite", "promotion"],
      "properties": {
        "exploration_rate": { "$ref": "#/$defs/ratio" },
        "rewrite": {
          "type": "object",
          "required": ["min_runs", "min_gain", "metric_weights", "auto_apply"],
          "properties": {
            "min_runs": { "type": "integer", "minimum": 1 },
            "min_gain": { "type": "number", "minimum": 0 },
            "metric_weights": {
              "type": "object",
              "required": ["time", "resource", "risk"],
              "properties": {
                "time": { "$ref": "#/$defs/ratio" },
                "resource": { "$ref": "#/$defs/ratio" },
                "risk": { "$ref": "#/$defs/ratio" }
              },
              "additionalProperties": false
            },
            "auto_apply": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "promotion": {
          "type": "object",
          "required": ["discoverable_requires"],
          "properties": {
            "discoverable_requires": {
              "type": "object",
              "required": ["player_runs", "agreement"],
              "properties": {
                "player_runs": { "type": "integer", "minimum": 1 },
                "agreement": { "$ref": "#/$defs/ratio" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
