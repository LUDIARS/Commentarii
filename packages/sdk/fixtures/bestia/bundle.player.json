        "path": "tactics/kite-wire-spider.json",
        "doc": {
          "id": "tactic:bestia:kite-wire-spider",
          "name": {
            "ja": "スパイダーの射程外へ下がる",
            "en": "Kite the wire spider"
          },
          "when": {
            "all": [
              {
                "entity": "enemy:bestia:wire-spider",
                "visible": true,
                "distance_lt": 19
              },
              {
                "self": {
                  "hp_ratio_lt": 0.5
                }
              }
            ]
          },
          "do": [
            {
              "move_to": "node:outer-ring"
            },
            {
              "attack": "$enemy"
            }
          ],
          "expect": {
            "within_sec": 3,
            "entity_state": {
              "$enemy": "state:bestia:battle-ai#chase"
            }
          },
          "because": [
            "enemy:bestia:wire-spider.stats.range",
            "rule:bestia:wounded-retreat"
          ],
          "knowledge": "discoverable",
          "confidence": "authored",
