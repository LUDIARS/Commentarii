{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "divergences.schema.json",
  "title": "Divergence candidates and the human verdict on each (observations/divergences.json)",
  "description": "Written by guide verify intent (spec/feature/intent-verify.md 4.3). Overlay data, never part of the canonical bundle: the tool proposes, a person decides (decision / decided_by / note); guide verify intent --accept moves an entry into the stage intent's allowed_divergences.",
  "type": "object",
  "required": ["game_id", "divergences"],
  "properties": {
    "game_id": { "$ref": "id.schema.json#/$defs/slug" },
    "divergences": {
      "type": "array",
      "items": { "$ref": "#/$defs/divergence" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "divergence": {
      "type": "object",
      "required": ["id", "stage", "intent", "kind", "reason", "summary", "runs", "personas", "signature", "decision"],
      "properties": {
        "id": { "$ref": "intent.schema.json#/$defs/divergenceId" },
        "stage": { "$ref": "id.schema.json#/$defs/stageId" },
        "intent": { "$ref": "id.schema.json#/$defs/intentId" },
        "kind": { "enum": ["interesting", "undesirable"] },
        "reason": { "$ref": "intent.schema.json#/$defs/divergenceReason" },
        "summary": { "type": "string", "minLength": 1 },
        "runs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "id.schema.json#/$defs/runId" } },
        "personas": { "type": "array", "uniqueItems": true, "items": { "$ref": "id.schema.json#/$defs/slug" } },
        "signature": { "$ref": "intent.schema.json#/$defs/signature" },
        "decision": { "enum": ["allow", "reject", "pending"] },
        "decided_by": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
