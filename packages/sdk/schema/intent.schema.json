{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intent.schema.json",
  "title": "Designer intent for one stage, and the divergences already accepted",
  "description": "source / draft are optional; an intent drafted by guide intent import carries source.kind = llm-draft and must stay draft: true until a human rewrites it.",
  "type": "object",
  "required": ["stage", "intended", "allowed_divergences"],
  "properties": {
    "stage": { "$ref": "id.schema.json#/$defs/stageId" },
    "intended": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/route" },
          { "$ref": "#/$defs/teach" },
          { "$ref": "#/$defs/time" },
          { "$ref": "#/$defs/forbid" }
        ]
      }
    },
    "allowed_divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run", "summary", "decided_by"],
        "properties": {
          "run": { "$ref": "id.schema.json#/$defs/runId" },
          "summary": { "type": "string", "minLength": 1 },
          "decided_by": { "type": "string", "minLength": 1 },
          "tactic": { "$ref": "id.schema.json#/$defs/tacticId" },
          "intent": { "description": "The intended item the divergence was found against (guide verify intent --accept).", "$ref": "id.schema.json#/$defs/intentId" },
          "reason": { "$ref": "#/$defs/divergenceReason" },
          "divergence": { "description": "ID in observations/divergences.json.", "$ref": "#/$defs/divergenceId" },
          "signature": { "$ref": "#/$defs/signature" },
          "praeforma": { "$ref": "praeforma-ref.schema.json#/$defs/ref" },
          "manifest_version": { "description": "Guide version the acceptance was judged under (guide verify intent --accept). Another version re-evaluates it.", "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "design_stance": {
      "description": "Design 8.5: open keeps many solutions, refined narrows them on purpose, mixed is both. Reports judge against it; absent = unspecified.",
      "enum": ["open", "refined", "mixed"]
    },
    "illusory_by_design": {
      "description": "Design 8.5: solutions meant to look possible but fail (e.g. a bait). Kept apart from the illusory findings.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rationale", "decided_by"],
        "properties": {
          "tactics": { "type": "array", "items": { "$ref": "id.schema.json#/$defs/tacticId" } },
          "route": { "type": "array", "items": { "$ref": "id.schema.json#/$defs/nodeId" } },
          "rationale": { "type": "string", "minLength": 1 },
          "decided_by": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["tactics"], "properties": { "tactics": { "minItems": 1 } } },
          { "required": ["route"], "properties": { "route": { "minItems": 1 } } }
        ],
        "additionalProperties": false
      }
    },
    "source": { "$ref": "value.schema.json#/$defs/source" },
    "draft": { "type": "boolean" }
  },
  "additionalProperties": false,
  "if": {
    "required": ["source"],
    "properties": { "source": { "required": ["kind"], "properties": { "kind": { "const": "llm-draft" } } } }
  },
  "then": {
    "required": ["draft"],
    "properties": { "draft": { "const": true } }
  },
  "$defs": {
    "divergenceReason": { "enum": ["alt-route", "shortcut", "teach-skipped", "over-time", "forbid-entered", "blocked-solution", "unexpected-solution", "skill-mismatch", "disclosure-mismatch", "choice-count-mismatch", "feel-mismatch"] },
    "levelDivergenceReason": {"enum":["blocked-solution","unexpected-solution","skill-mismatch","disclosure-mismatch","choice-count-mismatch","feel-mismatch"]},
    "divergenceId": { "type": "string", "pattern": "^div-[0-9a-f]{12}$" },
    "signature": {
      "description": "Tactic sequence + map node route of the runs a divergence groups (spec/feature/intent-verify.md 4.1).",
      "type": "object",
      "required": ["tactics", "route"],
      "properties": {
        "tactics": { "type": "array", "items": { "$ref": "id.schema.json#/$defs/tacticId" } },
        "route": { "type": "array", "items": { "$ref": "id.schema.json#/$defs/nodeId" } }
      },
      "additionalProperties": false
    },
    "common": {
      "properties": {
        "id": { "$ref": "id.schema.json#/$defs/intentId" },
        "note": { "type": "string", "minLength": 1 },
        "knowledge": { "$ref": "value.schema.json#/$defs/knowledge" },
        "praeforma": { "$ref": "praeforma-ref.schema.json#/$defs/ref" }
      }
    },
    "route": {
      "type": "object",
      "$ref": "#/$defs/common",
      "required": ["id", "kind", "path"],
      "properties": {
        "kind": { "const": "route" },
        "path": { "type": "array", "minItems": 2, "items": { "$ref": "id.schema.json#/$defs/nodeId" } },
        "level": { "$ref": "#/$defs/level" }
      },
      "unevaluatedProperties": false
    },
    "teach": {
      "type": "object",
      "$ref": "#/$defs/common",
      "required": ["id", "kind", "tactic"],
      "properties": {
        "kind": { "const": "teach" },
        "tactic": { "$ref": "id.schema.json#/$defs/tacticId" },
        "hints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
        "level": { "$ref": "#/$defs/level" }
      },
      "unevaluatedProperties": false
    },
    "levelEvidence": {"type":"object","required":["challenge","subject"],"properties":{"challenge":{"type":"string","pattern":"^ch:[a-z0-9][a-z0-9:_-]*$"},"subject":{"type":"string","minLength":1}},"additionalProperties":false},
    "level": {
      "type": "object",
      "required": [
        "challenge"
      ],
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^ch:[a-z0-9][a-z0-9:_-]*$"
        },
        "solutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/solution"
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "random": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/randomSource"
          }
        },
        "feel": {
          "enum": [
            "flat",
            "responsive",
            "uncontrolled"
          ]
        },
        "disclosure": {
          "enum": [
            "rule-taught",
            "late",
            "discovery"
          ]
        }
      },
      "additionalProperties": false
    },
    "solution": {
      "type": "object",
      "required": [
        "id",
        "rules",
        "skills",
        "styles"
      ],
      "properties": {
        "id": {
          "$ref": "id.schema.json#/$defs/slug"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
          "required": ["action", "targets", "conditions"],
            "properties": {
              "action": {
                "$ref": "id.schema.json#/$defs/actionId"
              },
            "targets": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "conditions": { "type": "string", "pattern": "^[01?]+$" }
            },
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "id.schema.json#/$defs/slug"
          }
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "options",
        "regime"
      ],
      "properties": {
        "id": {
          "$ref": "id.schema.json#/$defs/slug"
        },
        "options": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regime": {
          "enum": [
            "calm",
            "threat",
            "critical"
          ]
        }
      },
      "additionalProperties": false
    },
    "randomSource": {
      "type": "object",
      "required": [
        "id",
        "management"
      ],
      "properties": {
        "id": {
          "$ref": "id.schema.json#/$defs/slug"
        },
        "management": {
          "enum": [
            "bounded",
            "bag",
            "previewed",
            "narrow",
            "unmanaged"
          ]
        },
        "overlaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "id.schema.json#/$defs/slug"
          }
        }
      },
      "additionalProperties": false
    },
    "hint": {
      "type": "object",
      "required": ["when", "kind", "target"],
      "properties": {
        "when": { "$ref": "id.schema.json#/$defs/expression" },
        "kind": { "enum": ["rule", "solution"] },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "$ref": "#/$defs/common",
      "required": ["id", "kind", "range_sec"],
      "properties": {
        "kind": { "const": "time" },
        "range_sec": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
          "items": false,
          "minItems": 2
        }
      },
      "unevaluatedProperties": false
    },
    "forbid": {
      "type": "object",
      "$ref": "#/$defs/common",
      "required": ["id", "kind", "area"],
      "properties": {
        "kind": { "const": "forbid" },
        "area": { "$ref": "id.schema.json#/$defs/nodeId" }
      },
      "unevaluatedProperties": false
    }
  }
}
