{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage.schema.json",
  "title": "Stage: objectives, clear conditions and spawn table",
  "type": "object",
  "required": ["id", "name", "objectives"],
  "properties": {
    "id": { "$ref": "id.schema.json#/$defs/stageId" },
    "praeforma": { "description": "The Praeforma scene of this stage (spec/feature/praeforma-link.md).", "$ref": "praeforma-ref.schema.json#/$defs/ref" },
    "name": { "$ref": "id.schema.json#/$defs/localizedText" },
    "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "value.schema.json#/$defs/textValue" } },
    "clear_conditions": { "type": "array", "items": { "$ref": "value.schema.json#/$defs/textValue" } },
    "time_limit": { "$ref": "value.schema.json#/$defs/statValue" },
    "order": { "type": "integer" },
    "introduces": {
      "type": "array",
      "items": { "$ref": "#/$defs/introducedRule" }
    },
    "teaches": {
      "type": "array",
      "items": { "$ref": "#/$defs/taughtRule" }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "count"],
        "properties": {
          "entity": { "$ref": "id.schema.json#/$defs/entityId" },
          "count": { "$ref": "value.schema.json#/$defs/statValue" },
          "at": { "$ref": "id.schema.json#/$defs/nodeId" },
          "wave": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rulePair": {
      "type": "object",
      "required": ["action", "target_kind"],
      "properties": {
        "action": { "$ref": "id.schema.json#/$defs/actionId" },
        "target_kind": { "$ref": "id.schema.json#/$defs/entityId" }
      }
    },
    "introducedRule": {
      "$ref": "#/$defs/rulePair",
      "unevaluatedProperties": false
    },
    "taughtRule": {
      "type": "object",
      "$ref": "#/$defs/rulePair",
      "required": ["method"],
      "properties": { "method": { "enum": ["demonstration", "safe-trial", "text"] } },
      "unevaluatedProperties": false
    }
  }
}
