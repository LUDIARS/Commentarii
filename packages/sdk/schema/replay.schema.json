{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay.schema.json",
  "title": "Replay line: one line of replay/<run-id>.jsonl (design 14.A)",
  "description": "A run file is one header line, then one tick line per engine tick, then one footer line. Line order, tick order and the player-mode masked ban are checked by the loader (spec/feature/replay.md), not by this schema.",
  "type": "object",
  "required": ["type"],
  "properties": { "type": { "enum": ["header", "tick", "footer"] } },
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/tick" },
    { "$ref": "#/$defs/footer" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["type", "run_id", "seed", "game_id", "manifest_version", "adapter_id", "mode", "purpose", "started_at"],
      "properties": {
        "type": { "const": "header" },
        "run_id": { "$ref": "id.schema.json#/$defs/runId" },
        "seed": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "game_id": { "$ref": "id.schema.json#/$defs/slug" },
        "manifest_version": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "mode": { "enum": ["player", "omniscient"] },
        "purpose": { "enum": ["efficiency", "coverage", "human"] },
        "source": { "description": "human: a human play imported by guide import plays (design 14.D). Left out for engine runs.", "enum": ["human"] },
        "persona": { "$ref": "id.schema.json#/$defs/slug" },
        "decision_mode": { "description": "intent-assisted: the engine scored candidates with the designer's intent (spec/feature/engine.md 4.1). Absent = player knowledge only. Never counted as a persona's ability by guide verify intent.", "enum": ["intent-assisted"] },
        "observation_fields": {
          "description": "The game's observation field declarations the run was recorded under (manifest observation.fields, spec/feature/observation-boundary.md). Absent in older recordings: the base registry alone applies.",
          "$ref": "observation-fields.schema.json#/$defs/fields"
        },
        "engine": {
          "description": "The engine that recorded the run (Ingenium R0-B). Absent in recordings made before the engine moved out of Commentarii.",
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "sdk_version": { "description": "Version of @ludiars/commentarii-sdk the engine read the bundle with.", "type": "string", "minLength": 1 },
        "bundle_format": { "description": "bundle format_version (EXPORT_FORMAT_VERSION) the engine reads.", "type": "integer", "minimum": 1 },
        "bundle_hash": { "description": "Content hash of the canonical bundle the engine decided from (the bench bundle_hash).", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stance": {
          "description": "The engine's stance (spec/plan/2026-10-11-ingenium-integrated-design.md): guided = the authored tactics' Utility + BT, autonomous = no tactic or intent as input, hybrid = both through one evaluator.",
          "enum": ["autonomous", "guided", "hybrid"]
        },
        "started_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "tick": {
      "type": "object",
      "required": ["type", "tick", "t", "observation", "decision", "action"],
      "properties": {
        "type": { "const": "tick" },
        "tick": { "type": "integer", "minimum": 0 },
        "t": { "type": "number", "minimum": 0 },
        "observation": { "$ref": "observation-frame.schema.json" },
        "decision": { "type": "array", "items": { "$ref": "#/$defs/decisionEntry" } },
        "action": { "$ref": "#/$defs/action" },
        "model": { "$ref": "#/$defs/modelSummary" }
      },
      "additionalProperties": false
    },
    "modelSummary": {
      "description": "Optional (SDK 0.3.0, Ingenium R1): the decider's belief and affordances at this tick. A player run holds only what the player rulebook and the observations give (the masked check covers it like every line).",
      "type": "object",
      "properties": {
        "belief": {
          "type": "object",
          "required": ["tracked", "unknown"],
          "properties": {
            "tracked": { "description": "Owner variables the belief holds.", "type": "integer", "minimum": 0 },
            "unknown": { "description": "Of those, how many are a non-point interval.", "type": "integer", "minimum": 0 },
            "intervals": {
              "description": "<owner>.<variable> -> [lo, hi], for the ones the decider chose to log.",
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "prefixItems": [{ "type": "number" }, { "type": "number" }],
                "items": false,
                "minItems": 2
              }
            }
          },
          "additionalProperties": false
        },
        "affordances": {
          "description": "Own action IDs by class: now, uncertain (needs an experiment), reachable (in k steps), not_found (within the search bound), impossible.",
          "type": "object",
          "properties": {
            "now": { "$ref": "#/$defs/actionIds" },
            "uncertain": { "$ref": "#/$defs/actionIds" },
            "reachable": { "$ref": "#/$defs/actionIds" },
            "not_found": { "$ref": "#/$defs/actionIds" },
            "impossible": { "$ref": "#/$defs/actionIds" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "actionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^action:[a-z0-9][a-z0-9_-]*:[a-z0-9][a-z0-9_-]*$" }
    },
    "footer": {
      "type": "object",
      "required": ["type", "ended_at", "result", "summary"],
      "properties": {
        "type": { "const": "footer" },
        "ended_at": { "type": "string", "format": "date-time" },
        "result": { "enum": ["success", "fail", "abort"] },
        "summary": { "type": "object" }
      },
      "additionalProperties": false
    },
    "decisionEntry": {
      "description": "One candidate the decider weighed and its utility (design 7.4).",
      "type": "object",
      "required": ["candidate", "utility", "chosen"],
      "properties": {
        "candidate": { "type": "string", "minLength": 1 },
        "utility": { "type": "number" },
        "chosen": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "operand": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" },
        { "type": "array", "minItems": 1, "items": { "type": "number" } }
      ]
    },
    "action": {
      "description": "Abstract adapter action (design 7.3): exactly one verb. wait takes seconds (0 = one tick).",
      "type": "object",
      "properties": {
        "move_to": { "$ref": "#/$defs/operand" },
        "attack": { "$ref": "#/$defs/operand" },
        "use_item": { "$ref": "#/$defs/operand" },
        "use_skill": { "$ref": "#/$defs/operand" },
        "wait": { "type": "number", "minimum": 0 },
        "interact": { "$ref": "#/$defs/operand" },
        "custom": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/operand" },
        "params": { "type": "object" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["move_to"] },
        { "required": ["attack"] },
        { "required": ["use_item"] },
        { "required": ["use_skill"] },
        { "required": ["wait"] },
        { "required": ["interact"] },
        { "required": ["custom"] }
      ]
    }
  }
}
