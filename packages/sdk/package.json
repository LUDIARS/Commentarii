{
  "name": "@ludiars/commentarii-sdk",
  "version": "0.4.0",
  "private": true,
  "description": "Commentarii SDK: guide bundle and run-time data formats, invariants, mask checks, expression language and the parts that read what a guide makes possible",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./schemas": { "types": "./src/schemas.ts", "default": "./dist/schemas.js" },
    "./types": { "types": "./src/types.ts", "default": "./dist/types.js" },
    "./bundle": { "types": "./src/bundle.ts", "default": "./dist/bundle.js" },
    "./expression": { "types": "./src/expression.ts", "default": "./dist/expression.js" },
    "./rulebook": { "types": "./src/rulebook.ts", "default": "./dist/rulebook.js" },
    "./replay": { "types": "./src/replay.ts", "default": "./dist/replay.js" },
    "./observation": { "types": "./src/observation.ts", "default": "./dist/observation.js" },
    "./knowledge": { "types": "./src/knowledge.ts", "default": "./dist/knowledge.js" },
    "./fixtures": { "types": "./src/fixtures.ts", "default": "./dist/fixtures.js" },
    "./package.json": "./package.json"
  },
  "imports": {
    "#contract-runtime": {
      "types": "./contract-runtime.d.mts",
      "default": "./contract-runtime.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
